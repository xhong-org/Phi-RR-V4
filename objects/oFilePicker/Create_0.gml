///@desc 创建：游戏内宿主文件系统选择器（GX.games 没有系统对话框）
depth = -2000000;
on_ok = gx_file_picker_queue_chart;
on_cancel = undefined;
confirmed = false;
armed = false;
focus_url = false;
downloading = false;
download_id = -1;
download_url = "";
download_path = "";
download_got = 0;
download_total = 0;
url_text = "";
status_text = lang("picker.statusBrowse");
last_error = "";
api_mode = false;
api_list_id = -1;
api_roots_id = -1;
api_parent = "";
api_fetch_json = false;
api_job = "";
api_unpack_files = [];
api_unpack_index = 0;
items = [];
// GX 没有本地盘符，根目录留空；其他平台直接列盘。
roots = pls_is_gxgames() ? [] : gx_file_picker_roots();
root_rects = [];
selected = 0;
scroll = 0;
last_click_index = -1;
last_click_time = 0;
hover_open = false;
hover_cancel = false;
hover_folder = false;
hover_up = false;
hover_back = false;
hover_fwd = false;
hover_go = false;
hover_paste = false;
nav_history = [];
nav_future = [];
drive_cache = {};
last_dir_cached = "";
restore_pending = false;
current_dir = "";
layout_w = -1;
layout_h = -1;
layout_scale = -1;
layout_s = 1;
ui_font = pls_ui_font_add(24);
keyboard_string = "";
// 读上次目录缓存，再排一次界面。
gx_fp_cache_load();
if (string_length(last_dir_cached)) then current_dir = last_dir_cached;
gx_fp_layout();
